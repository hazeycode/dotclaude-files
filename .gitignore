# Transient only — .claude is NOT ignored wholesale, because the exemption
# lists (.claude/sandbox-exempt, .claude/bash-expansion-exempt) and a project
# .claude/settings.json are meant to be TRACKED and reviewed like any code.
.claude/worktrees/
.claude/state/
.claude/.cc-writes/

# Machine-local overrides and secrets — never commit to this public repo.
*.local.json
.credentials.json
.env
*.pem
*.key
id_rsa*

# Review windows land-lane instantiates from its template, one per landing.
# Untracked debris here fails the step-7 clean-checkout precheck on the NEXT
# landing, so it is ignored rather than merely deleted at cleanup.
land-review-*.code-workspace

# OS / editor cruft
.DS_Store
