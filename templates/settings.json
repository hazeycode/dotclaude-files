{
  "permissions": {
    "allow": [
      "TaskList",
      "TaskGet",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(git ls-files*)",
      "Bash(git grep*)",
      "Bash(git blame*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(cut*)",
      "Bash(sort*)",
      "Bash(uniq*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/projects/**/*.jsonl)",
      "Edit(~/.claude/**)",
      "Bash(git push*)",
      "Bash(git stash)",
      "Bash(git stash pop*)"
    ],
    "ask": [
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        "~",
        "/Users",
        "/home",
        "/etc/ssh",
        "/private/etc/ssh",
        "/var/db",
        "/private/var/db",
        "/var/root",
        "/Library",
        "/Library/Keychains"
      ],
      "allowRead": [
        "/Library/Developer",
        "~/.gitconfig",
        "~/.config/git",
        "~/.claude/settings.json",
        "~/.claude/skills",
        "~/.claude/agents",
        "~/.claude/hooks",
        "~/.claude/CLAUDE.md"
      ],
      "allowWrite": ["/tmp/claude"]
    },
    "network": {
      "strictAllowlist": false,
      "allowedDomains": []
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-lane-tier.sh",
            "timeout": 10,
            "statusMessage": "Checking lane tier declaration"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-allowlisted-bash.sh",
            "timeout": 10,
            "statusMessage": "Guarding allowlisted bash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/refuse-sandbox-override.sh",
            "timeout": 10,
            "statusMessage": "Refusing sandbox override"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-exemption-writes.sh",
            "timeout": 10,
            "statusMessage": "Guarding exemption files"
          }
        ]
      }
    ]
  },
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true
}
